# Copie este archivo como .env.local (no se versiona) y complete los valores.
# En Vercel, las mismas variables se definen en Settings > Environment Variables.

# Dominio del backend desplegado en Render, sin barra final (por ejemplo https://sga-api.onrender.com).
# En desarrollo se deja vacío: Vite reenvía /api al backend local en el puerto 9090.
VITE_API_URL=

# Token público de Mapbox para el mapa de ubicación. Si se omite, se muestra la
# ubicación con un enlace a OpenStreetMap y el sistema funciona igual.
VITE_MAPBOX_TOKEN=
