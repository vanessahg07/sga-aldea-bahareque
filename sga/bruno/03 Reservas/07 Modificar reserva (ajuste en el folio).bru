meta {
  name: Modificar reserva (ajuste en el folio)
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/reservas/{{idReserva}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcion}}
}

body:json {
  {
    "entrada": "{{entrada}}",
    "salida": "{{salida}}",
    "acompanantes": [
      {"nombre": "Felipe Gómez", "fechaNacimiento": "1989-08-04"},
      {"nombre": "Ana Gómez", "fechaNacimiento": "1962-04-30"}
    ],
    "mascotas": 0
  }
}

script:pre-request {
  const dia = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return d.toLocaleDateString("en-CA"); };
  bru.setVar("hoy", dia(0));
  bru.setVar("entrada", dia(45));
  bru.setVar("salida", dia(48));
}
