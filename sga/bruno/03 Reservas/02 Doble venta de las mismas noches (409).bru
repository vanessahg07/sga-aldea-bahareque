meta {
  name: Doble venta de las mismas noches (409)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/reservas/directas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcion}}
}

body:json {
  {
    "titular": {"nombre": "Pedro Pérez", "documento": "71555444", "fechaNacimiento": "1980-01-01"},
    "codigoApartamento": "BH-201",
    "entrada": "{{entrada}}",
    "salida": "{{salida}}",
    "horaEstimadaLlegada": "15:00"
  }
}

script:pre-request {
  const dia = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return d.toLocaleDateString("en-CA"); };
  bru.setVar("hoy", dia(0));
  bru.setVar("entrada", dia(45));
  bru.setVar("salida", dia(48));
}
