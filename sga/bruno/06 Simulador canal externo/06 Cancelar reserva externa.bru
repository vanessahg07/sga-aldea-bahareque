meta {
  name: Cancelar reserva externa
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/canal/reservas/{{idExterno}}
  body: none
  auth: none
}

headers {
  X-Canal: {{codigoCanal}}
  X-Credencial-Canal: {{credencialCanal}}
}

tests {
  test("200 CANCELADA", () => {
    expect(res.status).to.equal(200);
    expect(res.body.resultado).to.equal("CANCELADA");
  });
}
