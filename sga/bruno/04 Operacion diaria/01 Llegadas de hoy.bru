meta {
  name: Llegadas de hoy
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/reservas/llegadas?fecha={{hoy}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcion}}
}

script:pre-request {
  const dia = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return d.toLocaleDateString("en-CA"); };
  bru.setVar("hoy", dia(0));
  bru.setVar("entrada", dia(45));
  bru.setVar("salida", dia(48));
}

script:post-response {
  if (res.body.length) bru.setVar("idLlegada", res.body[0].id);
}
