meta {
  name: Cotizar estancia
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/cotizaciones
  body: json
  auth: none
}

body:json {
  {
    "codigoApartamento": "BH-201",
    "entrada": "{{entrada}}",
    "salida": "{{salida}}",
    "fechasNacimiento": ["1990-05-10", "1989-08-04", "2022-01-15"]
  }
}

script:pre-request {
  const dia = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return d.toLocaleDateString("en-CA"); };
  bru.setVar("hoy", dia(0));
  bru.setVar("entrada", dia(45));
  bru.setVar("salida", dia(48));
}
